# Keycloak Database
KC_DB_PASSWORD=<your-keycloak-db-password>

# Keycloak Admin (used on first startup to bootstrap admin account)
KEYCLOAK_ADMIN=<admin-username>
KEYCLOAK_ADMIN_PASSWORD=<admin-password>

# BFF Gateway OAuth2 Client
KC_CLIENT_SECRET=<bff-gateway-client-secret-from-keycloak>

# Authorization Redis (dedicated instance on port 6380)
AUTHZ_REDIS_HOST=localhost
AUTHZ_REDIS_PORT=6380